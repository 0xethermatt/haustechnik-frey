# Wärmepumpen-Check (Anfrageformular) – E-Mail-Versand über Resend (resend.com)
# Domain haustechnik-frey.de in Resend verifizieren (DNS-Einträge), dann API-Key anlegen.
RESEND_API_KEY=
# Absender (muss zur verifizierten Domain gehören)
ANFRAGE_EMAIL_FROM="Haustechnik Frey <anfrage@haustechnik-frey.de>"
# Empfänger im Büro, mehrere durch Komma getrennt
ANFRAGE_EMAIL_TO=info@haustechnik-frey.de

# KI-Berater (Chat) – auf /waermepumpe automatisch aktiv, sobald ein Key gesetzt ist
OPENAI_API_KEY=
# Schwebendes Chat-Widget auf allen Seiten ("true") / auch auf /waermepumpe deaktivieren ("false")
NEXT_PUBLIC_ENERGY_ADVISOR_ENABLED=
